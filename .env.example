# Host-side generators write to the PostgreSQL HA primary by default.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce_ods
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONNECT_TIMEOUT=10

# Host-side validation reads from ClickHouse's HTTP endpoint.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=ecommerce_ods
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
VALIDATION_TIMEOUT=10
VALIDATION_HISTORY_ENABLED=1
VALIDATION_HISTORY_SOURCE=cli

# Local MinIO stores Flink checkpoint/savepoint state for Version 3.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_FLINK_BUCKET=flink-state
